  "strings": {
    "lock_access_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your private workspace is locked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu espacio privado está bloqueado"
          }
        }
      }
    },
