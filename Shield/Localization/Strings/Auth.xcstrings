      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved files remain encrypted while MaskID is locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos guardados permanecen cifrados mientras MaskID está bloqueado."
          }
